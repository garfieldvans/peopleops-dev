# Copy to .env for local development. Never commit real secrets.
# The Prisma CLI reads this file through packages/database/prisma7.config.ts.

DATABASE_URL="postgresql://peopleops:peopleops_dev@localhost:5432/peopleops?schema=public"

# API
NODE_ENV=development
PORT=3001
COMPANY_TIMEZONE=Asia/Jakarta
CORS_ORIGIN=http://localhost:5174

# Auth. Generate your own: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Set true when the API is served over HTTPS (required in production).
COOKIE_SECURE=false

# Bootstrap only, used by `pnpm db:seed`. Remove after the first administrator exists.
# If SEED_ADMIN_PASSWORD is omitted, the seed prints a generated password once.
# SEED_ADMIN_EMAIL=admin@peopleops.local
# SEED_ADMIN_PASSWORD=

# Web (Vite). Relative path keeps requests on the dev proxy; use an absolute
# URL only when the API is served from another host.
VITE_API_BASE_URL=/api/v1

# Optional: where the Vite dev server proxies /api. Defaults to the API port above.
# VITE_DEV_API_TARGET=http://localhost:3001
