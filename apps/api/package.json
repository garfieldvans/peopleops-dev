{
  "name": "@peopleops/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "seed": "tsx prisma/seed.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-e2e.json --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "seed:demo": "tsx prisma/seed-demo.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.jest.json",
          "useESM": true
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "testEnvironment": "node",
    "clearMocks": true
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/jwt": "12.0.5",
    "@nestjs/platform-express": "12.6.0",
    "@nestjs/swagger": "12.1.2",
    "@nestjs/throttler": "6.8.0",
    "@peopleops/database": "workspace:*",
    "@peopleops/leave-engine": "workspace:*",
    "@peopleops/shared-types": "workspace:*",
    "@peopleops/validators": "workspace:*",
    "argon2": "0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "luxon": "^3.7.2",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/cli": "12.0.15",
    "@nestjs/testing": "12.6.0",
    "@peopleops/config": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^6.0.3",
    "eslint": "10.15.0",
    "jest": "30.5.2",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
