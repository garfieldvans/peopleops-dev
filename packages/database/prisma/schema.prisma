// PeopleOps database schema.
//
// Phases 1–6: authentication/RBAC, organization and employees, attendance,
// leave, and overtime. Payroll, performance, and notification tables arrive
// with their modules. See docs/database/erd.md.
//
// Prisma 7 requires a driver adapter at runtime; the connection is created in
// packages/database/src/index.ts (@prisma/adapter-pg).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  roles    UserRole[]
  sessions UserSession[]
  /// A login account exists independently of an employee record; the link is optional.
  employee Employee?

  employmentHistoriesCreated  EmploymentHistory[]          @relation("EmploymentHistoryCreator")
  documentsUploaded           EmployeeDocument[]           @relation("EmployeeDocumentUploader")
  scheduleAssignmentsCreated  EmployeeScheduleAssignment[] @relation("ScheduleAssignmentCreator")
  attendanceBreaksCreated     AttendanceBreak[]            @relation("AttendanceBreakCreator")
  correctionsReviewed         AttendanceCorrection[]       @relation("AttendanceCorrectionReviewer")
  leaveAssignmentsCreated     LeavePolicyAssignment[]      @relation("LeaveAssignmentCreator")
  leaveTransactionsCreated    LeaveTransaction[]           @relation("LeaveTransactionCreator")
  leaveApprovals              LeaveRequestApproval[]       @relation("LeaveApprovalActor")
  leaveRequestsReviewed       LeaveRequest[]               @relation("LeaveRequestReviewer")
  leaveRequestsCancelled      LeaveRequest[]               @relation("LeaveRequestCanceller")
  leaveAttachmentsUploaded    LeaveAttachment[]            @relation("LeaveAttachmentUploader")
  overtimeAssignmentsCreated  OvertimePolicyAssignment[]   @relation("OvertimeAssignmentCreator")
  overtimeApprovals           OvertimeApproval[]           @relation("OvertimeApprovalActor")
  overtimeRequestsVerified    OvertimeRequest[]            @relation("OvertimeRequestVerifier")
  overtimeRequestsCancelled   OvertimeRequest[]            @relation("OvertimeRequestCanceller")
  overtimeCorrections         OvertimeCorrection[]         @relation("OvertimeCorrectionActor")
  overtimeAttachmentsUploaded OvertimeAttachment[]         @relation("OvertimeAttachmentUploader")
  payrollCompensationsCreated EmployeeCompensation[]       @relation("PayrollCompensationCreator")
  payrollAssignmentsCreated   EmployeePayrollAssignment[]  @relation("PayrollAssignmentCreator")
  payrollPeriodsCreated       PayrollPeriod[]              @relation("PayrollPeriodCreator")
  payrollRunsCreated          PayrollRun[]                 @relation("PayrollRunCreator")
  payrollRunsApproved         PayrollRun[]                 @relation("PayrollRunApprover")
  payrollRunsPublished        PayrollRun[]                 @relation("PayrollRunPublisher")
  payrollRunApprovals         PayrollRunApproval[]         @relation("PayrollRunApprovalActor")
  payrollAdjustmentsCreated   PayrollAdjustment[]          @relation("PayrollAdjustmentCreator")
  payrollAdjustmentsReviewed  PayrollAdjustment[]          @relation("PayrollAdjustmentReviewer")
  onboardingsCreated          EmployeeOnboarding[]         @relation("OnboardingCreator")
  onboardingTasksAssigned     OnboardingTask[]             @relation("OnboardingTaskAssignee")
  offboardingsInitiated       EmployeeOffboarding[]        @relation("OffboardingInitiator")
  offboardingTasksAssigned    OffboardingTask[]            @relation("OffboardingTaskAssignee")
  performanceCyclesCreated    PerformanceCycle[]           @relation("PerformanceCycleCreator")
  performanceGoalsCreated     PerformanceGoal[]            @relation("PerformanceGoalCreator")
  performanceGoalUpdates      PerformanceGoalUpdate[]      @relation("PerformanceGoalUpdateActor")
  performanceReviewsCreated   PerformanceReview[]          @relation("PerformanceReviewCreator")
  performanceReviewsReviewed  PerformanceReview[]          @relation("PerformanceReviewReviewer")
  trainingProgramsCreated     TrainingProgram[]            @relation("TrainingProgramCreator")
  trainingEnrollmentsApproved TrainingEnrollment[]         @relation("TrainingEnrollmentApprover")
  trainingDocumentsUploaded   TrainingDocument[]           @relation("TrainingDocumentUploader")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  /// System roles (SUPER_ADMIN) are protected from deletion and permission edits.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  /// SHA-256 hash of the opaque refresh token. The raw value never touches the database.
  refreshTokenHash String    @unique @map("refresh_token_hash")
  /// Rotated tokens of one login share a family, enabling reuse detection.
  familyId         String    @map("family_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Append-only security trail. No foreign keys: history must survive user changes.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 3 — Organization & employees
// ---------------------------------------------------------------------------

/// Company-level master status. Records are deactivated, not deleted, so that
/// historical employment data keeps a valid reference.
enum MasterStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  INTERN
  FREELANCE
  PART_TIME
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  INACTIVE
  RESIGNED
  TERMINATED
}

enum EmployeeDocumentCategory {
  CONTRACT
  IDENTITY
  CERTIFICATE
  OTHER
}

/// Single-company deployment: exactly one row, seeded and then updated in place.
model Company {
  id                 String   @id @default(uuid()) @db.Uuid
  name               String
  code               String   @unique
  registrationNumber String?  @map("registration_number")
  email              String
  phone              String?
  website            String?
  addressLine        String?  @map("address_line")
  city               String?
  province           String?
  postalCode         String?  @map("postal_code")
  country            String   @default("Indonesia")
  logoUrl            String?  @map("logo_url")
  timezone           String   @default("Asia/Jakarta")
  currency           String   @default("IDR")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  code       String       @unique
  address    String?
  city       String?
  province   String?
  postalCode String?      @map("postal_code")
  phone      String?
  email      String?
  status     MasterStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  departments         Department[]
  employees           Employee[]
  history             EmploymentHistory[]
  holidays            Holiday[]
  overtimeAssignments OvertimePolicyAssignment[]

  @@index([status])
  @@map("branches")
}

model JobLevel {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  code         String       @unique
  description  String?
  displayOrder Int          @default(0) @map("display_order")
  status       MasterStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  positions Position[]
  employees Employee[]
  history   EmploymentHistory[]

  @@index([displayOrder])
  @@map("job_levels")
}

/// Departments form a tree per company. `branch_id` is optional because a
/// department can span branches; codes are unique company-wide.
model Department {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  code           String       @unique
  description    String?
  status         MasterStatus @default(ACTIVE)
  branchId       String?      @map("branch_id") @db.Uuid
  parentId       String?      @map("parent_id") @db.Uuid
  headEmployeeId String?      @map("head_employee_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  branch              Branch?                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  parent              Department?                @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Department[]               @relation("DepartmentHierarchy")
  head                Employee?                  @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)
  positions           Position[]
  employees           Employee[]
  history             EmploymentHistory[]
  overtimeAssignments OvertimePolicyAssignment[]

  @@index([parentId])
  @@index([branchId])
  @@index([headEmployeeId])
  @@map("departments")
}

model Position {
  id           String       @id @default(uuid()) @db.Uuid
  title        String
  code         String       @unique
  description  String?
  status       MasterStatus @default(ACTIVE)
  departmentId String       @map("department_id") @db.Uuid
  jobLevelId   String?      @map("job_level_id") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  department Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  jobLevel   JobLevel?           @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  employees  Employee[]
  history    EmploymentHistory[]

  @@index([departmentId])
  @@index([jobLevelId])
  @@map("positions")
}

/// An employee exists independently of a login account: `user_id` is optional
/// and unique, so one account can never be linked to two employees.
model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  employeeNumber    String           @unique @map("employee_number")
  firstName         String           @map("first_name")
  middleName        String?          @map("middle_name")
  lastName          String           @map("last_name")
  preferredName     String?          @map("preferred_name")
  gender            Gender?
  birthDate         DateTime?        @map("birth_date") @db.Date
  placeOfBirth      String?          @map("place_of_birth")
  maritalStatus     MaritalStatus?   @map("marital_status")
  nationality       String?
  personalEmail     String           @map("personal_email")
  phone             String?
  addressLine       String?          @map("address_line")
  city              String?
  province          String?
  postalCode        String?          @map("postal_code")
  country           String           @default("Indonesia")
  photoUrl          String?          @map("photo_url")
  employmentType    EmploymentType   @map("employment_type")
  employmentStatus  EmploymentStatus @default(ACTIVE) @map("employment_status")
  joinDate          DateTime         @map("join_date") @db.Date
  probationEndDate  DateTime?        @map("probation_end_date") @db.Date
  contractStartDate DateTime?        @map("contract_start_date") @db.Date
  contractEndDate   DateTime?        @map("contract_end_date") @db.Date
  workEmail         String?          @map("work_email")
  branchId          String?          @map("branch_id") @db.Uuid
  departmentId      String?          @map("department_id") @db.Uuid
  positionId        String?          @map("position_id") @db.Uuid
  jobLevelId        String?          @map("job_level_id") @db.Uuid
  managerId         String?          @map("manager_id") @db.Uuid
  userId            String?          @unique @map("user_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  jobLevel   JobLevel?   @relation(fields: [jobLevelId], references: [id], onDelete: Restrict)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports    Employee[]  @relation("EmployeeManager")

  headedDepartments     Department[]                 @relation("DepartmentHead")
  historyAsManager      EmploymentHistory[]          @relation("EmploymentHistoryManager")
  employmentHistories   EmploymentHistory[]
  emergencyContacts     EmployeeEmergencyContact[]
  documents             EmployeeDocument[]
  scheduleAssignments   EmployeeScheduleAssignment[]
  attendanceRecords     AttendanceRecord[]
  attendanceCorrections AttendanceCorrection[]
  leaveAssignments      LeavePolicyAssignment[]
  leavePeriods          LeaveEntitlementPeriod[]
  leaveTransactions     LeaveTransaction[]
  leaveRequests         LeaveRequest[]
  leaveReservations     LeaveBalanceReservation[]
  overtimeAssignments   OvertimePolicyAssignment[]
  overtimeRequests      OvertimeRequest[]
  compensations         EmployeeCompensation[]
  payrollAssignments    EmployeePayrollAssignment[]
  payrollPayslips       PayrollPayslip[]
  payrollAdjustments    PayrollAdjustment[]
  onboardings           EmployeeOnboarding[]
  offboardings          EmployeeOffboarding[]
  performanceGoals      PerformanceGoal[]
  performanceReviews    PerformanceReview[]
  trainingEnrollments   TrainingEnrollment[]
  trainingDocuments     TrainingDocument[]

  @@index([lastName, firstName])
  @@index([branchId])
  @@index([departmentId])
  @@index([positionId])
  @@index([jobLevelId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

model EmployeeEmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  fullName     String   @map("full_name")
  relationship String
  phone        String
  email        String?
  address      String?
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

/// Metadata only. Binary content lives behind the storage abstraction
/// (`storage_key`), never in PostgreSQL and never behind a public URL.
model EmployeeDocument {
  id           String                   @id @default(uuid()) @db.Uuid
  employeeId   String                   @map("employee_id") @db.Uuid
  category     EmployeeDocumentCategory @default(OTHER)
  title        String
  fileName     String                   @map("file_name")
  mimeType     String                   @map("mime_type")
  sizeBytes    Int                      @map("size_bytes")
  storageKey   String                   @unique @map("storage_key")
  uploadedById String?                  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at")

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("EmployeeDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@map("employee_documents")
}

/// Append-only trail of employment assignments. The current assignment lives on
/// `employees`; history rows are written in the same transaction as a change.
model EmploymentHistory {
  id               String           @id @default(uuid()) @db.Uuid
  employeeId       String           @map("employee_id") @db.Uuid
  effectiveFrom    DateTime         @map("effective_from") @db.Date
  effectiveTo      DateTime?        @map("effective_to") @db.Date
  employmentType   EmploymentType   @map("employment_type")
  employmentStatus EmploymentStatus @map("employment_status")
  branchId         String?          @map("branch_id") @db.Uuid
  departmentId     String?          @map("department_id") @db.Uuid
  positionId       String?          @map("position_id") @db.Uuid
  jobLevelId       String?          @map("job_level_id") @db.Uuid
  managerId        String?          @map("manager_id") @db.Uuid
  changeReason     String?          @map("change_reason")
  notes            String?
  createdById      String?          @map("created_by_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position   Position?   @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobLevel   JobLevel?   @relation(fields: [jobLevelId], references: [id], onDelete: SetNull)
  manager    Employee?   @relation("EmploymentHistoryManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation("EmploymentHistoryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  @@map("employment_histories")
}

// ---------------------------------------------------------------------------
// Attendance (Phase 4)
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY_LEAVE
  ABSENT
  HALF_DAY
  INCOMPLETE
  ON_LEAVE
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceCorrectionType {
  CLOCK_IN
  CLOCK_OUT
  BOTH
}

enum HolidayType {
  NATIONAL
  COMPANY
  BRANCH
}

/// Expected working days and hours. Times are wall-clock values interpreted in
/// the company timezone; an end time earlier than the start time crosses midnight.
model WorkSchedule {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  code              String       @unique
  description       String?
  graceLateMinutes  Int          @default(0) @map("grace_late_minutes")
  graceEarlyMinutes Int          @default(0) @map("grace_early_minutes")
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  days        WorkScheduleDay[]
  assignments EmployeeScheduleAssignment[]
  records     AttendanceRecord[]

  @@map("work_schedules")
}

model WorkScheduleDay {
  id           String  @id @default(uuid()) @db.Uuid
  scheduleId   String  @map("schedule_id") @db.Uuid
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  dayOfWeek    Int     @map("day_of_week")
  isWorkingDay Boolean @default(true) @map("is_working_day")
  startTime    String? @map("start_time") @db.VarChar(5)
  endTime      String? @map("end_time") @db.VarChar(5)
  breakMinutes Int     @default(0) @map("break_minutes")

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek])
  @@map("work_schedule_days")
}

/// Shift master. A shift replaces the schedule's daily hours when assigned.
model Shift {
  id                String       @id @default(uuid()) @db.Uuid
  name              String
  code              String       @unique
  description       String?
  startTime         String       @map("start_time") @db.VarChar(5)
  endTime           String       @map("end_time") @db.VarChar(5)
  breakMinutes      Int          @default(0) @map("break_minutes")
  graceLateMinutes  Int          @default(0) @map("grace_late_minutes")
  graceEarlyMinutes Int          @default(0) @map("grace_early_minutes")
  status            MasterStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  assignments EmployeeScheduleAssignment[]
  records     AttendanceRecord[]

  @@map("shifts")
}

/// An effective-dated schedule/shift assignment. Historical rows are never edited
/// retroactively; a change closes the previous row and inserts a new one.
model EmployeeScheduleAssignment {
  id             String    @id @default(uuid()) @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  workScheduleId String    @map("work_schedule_id") @db.Uuid
  shiftId        String?   @map("shift_id") @db.Uuid
  effectiveFrom  DateTime  @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  changeReason   String?   @map("change_reason")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  employee     Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule       @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  shift        Shift?             @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("ScheduleAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  records      AttendanceRecord[]

  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@map("employee_schedule_assignments")
}

/// One row per employee per scheduled work date. For an overnight shift the work
/// date is the local date on which the shift starts.
model AttendanceRecord {
  id                   String           @id @default(uuid()) @db.Uuid
  employeeId           String           @map("employee_id") @db.Uuid
  scheduleAssignmentId String?          @map("schedule_assignment_id") @db.Uuid
  workScheduleId       String?          @map("work_schedule_id") @db.Uuid
  shiftId              String?          @map("shift_id") @db.Uuid
  workDate             DateTime         @map("work_date") @db.Date
  timezone             String
  scheduledStartAt     DateTime         @map("scheduled_start_at")
  scheduledEndAt       DateTime         @map("scheduled_end_at")
  expectedBreakMinutes Int              @default(0) @map("expected_break_minutes")
  graceLateMinutes     Int              @default(0) @map("grace_late_minutes")
  graceEarlyMinutes    Int              @default(0) @map("grace_early_minutes")
  clockInAt            DateTime?        @map("clock_in_at")
  clockOutAt           DateTime?        @map("clock_out_at")
  status               AttendanceStatus @default(INCOMPLETE)
  lateMinutes          Int              @default(0) @map("late_minutes")
  earlyLeaveMinutes    Int              @default(0) @map("early_leave_minutes")
  workedMinutes        Int              @default(0) @map("worked_minutes")
  breakMinutesTaken    Int              @default(0) @map("break_minutes_taken")
  isCorrected          Boolean          @default(false) @map("is_corrected")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  employee         Employee                    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignment       EmployeeScheduleAssignment? @relation(fields: [scheduleAssignmentId], references: [id], onDelete: SetNull)
  workSchedule     WorkSchedule?               @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  shift            Shift?                      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  breaks           AttendanceBreak[]
  corrections      AttendanceCorrection[]
  overtimeRequests OvertimeRequest[]

  @@unique([employeeId, workDate])
  @@index([workDate, status])
  @@index([employeeId, workDate])
  @@index([scheduleAssignmentId])
  @@map("attendance_records")
}

model AttendanceBreak {
  id                 String    @id @default(uuid()) @db.Uuid
  attendanceRecordId String    @map("attendance_record_id") @db.Uuid
  startedAt          DateTime  @map("started_at")
  endedAt            DateTime? @map("ended_at")
  createdById        String?   @map("created_by_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  attendance AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  createdBy  User?            @relation("AttendanceBreakCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([attendanceRecordId])
  @@map("attendance_breaks")
}

model AttendanceCorrection {
  id                  String                     @id @default(uuid()) @db.Uuid
  employeeId          String                     @map("employee_id") @db.Uuid
  attendanceRecordId  String?                    @map("attendance_record_id") @db.Uuid
  workDate            DateTime                   @map("work_date") @db.Date
  type                AttendanceCorrectionType
  status              AttendanceCorrectionStatus @default(PENDING)
  originalClockInAt   DateTime?                  @map("original_clock_in_at")
  originalClockOutAt  DateTime?                  @map("original_clock_out_at")
  requestedClockInAt  DateTime?                  @map("requested_clock_in_at")
  requestedClockOutAt DateTime?                  @map("requested_clock_out_at")
  reason              String
  reviewedById        String?                    @map("reviewed_by_id") @db.Uuid
  reviewNotes         String?                    @map("review_notes")
  reviewedAt          DateTime?                  @map("reviewed_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  employee   Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  reviewer   User?             @relation("AttendanceCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([attendanceRecordId])
  @@map("attendance_corrections")
}

model Holiday {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  date        DateTime     @db.Date
  description String?
  type        HolidayType
  branchId    String?      @map("branch_id") @db.Uuid
  status      MasterStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([date, status])
  @@index([branchId])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Phase 5 — Leave management
// ---------------------------------------------------------------------------

enum LeaveDurationUnit {
  DAY
  HOUR
}

enum LeaveAccrualMethod {
  GRANTED_UPFRONT
  MONTHLY_ACCRUAL
  ANNUAL_ACCRUAL
  MANUAL_GRANT
}

enum LeaveAccrualFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum LeaveAccrualStartRule {
  PERIOD_START
  ASSIGNMENT_START
}

enum LeaveApprovalMode {
  MANAGER
  HR
  MANAGER_AND_HR
}

enum LeaveApprovalStage {
  MANAGER
  HR
}

enum LeaveApprovalDecision {
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum LeaveRequestMode {
  FULL_DAY
  HALF_DAY
  HOURLY
}

enum LeaveHalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum LeaveTransactionType {
  OPENING_BALANCE
  ENTITLEMENT
  ACCRUAL
  LEAVE_DEDUCTION
  LEAVE_REVERSAL
  CARRY_OVER
  EXPIRATION
  ADJUSTMENT
}

enum LeaveReservationStatus {
  PENDING
  CONSUMED
  RELEASED
}

enum LeavePeriodStatus {
  OPEN
  CLOSED
}

model LeaveType {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  code               String       @unique
  description        String?
  isPaid             Boolean      @default(true) @map("is_paid")
  requiresApproval   Boolean      @default(true) @map("requires_approval")
  requiresAttachment Boolean      @default(false) @map("requires_attachment")
  allowHalfDay       Boolean      @default(false) @map("allow_half_day")
  allowPastDates     Boolean      @default(false) @map("allow_past_dates")
  allowFutureDates   Boolean      @default(true) @map("allow_future_dates")
  requiresBalance    Boolean      @default(true) @map("requires_balance")
  status             MasterStatus @default(ACTIVE)
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  policies     LeavePolicy[]
  assignments  LeavePolicyAssignment[]
  periods      LeaveEntitlementPeriod[]
  transactions LeaveTransaction[]
  requests     LeaveRequest[]
  reservations LeaveBalanceReservation[]

  @@index([status])
  @@map("leave_types")
}

model LeavePolicy {
  id                        String                @id @default(uuid()) @db.Uuid
  name                      String
  code                      String                @unique
  description               String?
  leaveTypeId               String                @map("leave_type_id") @db.Uuid
  entitlementAmount         Decimal               @default(0) @map("entitlement_amount") @db.Decimal(10, 2)
  entitlementUnit           LeaveDurationUnit     @default(DAY) @map("entitlement_unit")
  accrualMethod             LeaveAccrualMethod    @default(GRANTED_UPFRONT) @map("accrual_method")
  accrualFrequency          LeaveAccrualFrequency @default(ONE_TIME) @map("accrual_frequency")
  accrualStartRule          LeaveAccrualStartRule @default(PERIOD_START) @map("accrual_start_rule")
  eligibilityMonths         Int                   @default(0) @map("eligibility_months")
  maxBalance                Decimal?              @map("max_balance") @db.Decimal(10, 2)
  carryOverEnabled          Boolean               @default(false) @map("carry_over_enabled")
  maxCarryOverAmount        Decimal?              @map("max_carry_over_amount") @db.Decimal(10, 2)
  carryOverExpirationMonths Int?                  @map("carry_over_expiration_months")
  minRequestDuration        Decimal?              @map("min_request_duration") @db.Decimal(10, 2)
  maxRequestDuration        Decimal?              @map("max_request_duration") @db.Decimal(10, 2)
  minAdvanceNoticeDays      Int                   @default(0) @map("min_advance_notice_days")
  allowNegativeBalance      Boolean               @default(false) @map("allow_negative_balance")
  allowHalfDay              Boolean               @default(false) @map("allow_half_day")
  allowUnpaidLeave          Boolean               @default(true) @map("allow_unpaid_leave")
  approvalMode              LeaveApprovalMode     @default(MANAGER) @map("approval_mode")
  leaveYearStartMonth       Int                   @default(1) @map("leave_year_start_month")
  cancellationCutoffDays    Int                   @default(0) @map("cancellation_cutoff_days")
  effectiveFrom             DateTime              @map("effective_from") @db.Date
  effectiveTo               DateTime?             @map("effective_to") @db.Date
  status                    MasterStatus          @default(ACTIVE)
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")

  leaveType   LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  assignments LeavePolicyAssignment[]
  periods     LeaveEntitlementPeriod[]

  @@index([leaveTypeId, status])
  @@index([effectiveFrom, effectiveTo])
  @@map("leave_policies")
}

/// Explicit, effective-dated assignment. The exclusion constraint in the migration
/// prevents two ACTIVE assignments for the same employee/type from overlapping.
model LeavePolicyAssignment {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @map("employee_id") @db.Uuid
  leaveTypeId   String       @map("leave_type_id") @db.Uuid
  policyId      String       @map("policy_id") @db.Uuid
  effectiveFrom DateTime     @map("effective_from") @db.Date
  effectiveTo   DateTime?    @map("effective_to") @db.Date
  status        MasterStatus @default(ACTIVE)
  notes         String?
  createdById   String?      @map("created_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  employee  Employee                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  policy    LeavePolicy              @relation(fields: [policyId], references: [id], onDelete: Restrict)
  createdBy User?                    @relation("LeaveAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  periods   LeaveEntitlementPeriod[]

  @@index([employeeId, leaveTypeId, effectiveFrom])
  @@index([policyId])
  @@map("leave_policy_assignments")
}

/// Immutable snapshot of one employee/type leave year. The policy snapshot keeps
/// historical calculations stable when the policy row is edited later.
model LeaveEntitlementPeriod {
  id                String            @id @default(uuid()) @db.Uuid
  employeeId        String            @map("employee_id") @db.Uuid
  leaveTypeId       String            @map("leave_type_id") @db.Uuid
  policyId          String            @map("policy_id") @db.Uuid
  assignmentId      String?           @map("assignment_id") @db.Uuid
  periodStart       DateTime          @map("period_start") @db.Date
  periodEnd         DateTime          @map("period_end") @db.Date
  entitlementAmount Decimal           @map("entitlement_amount") @db.Decimal(10, 2)
  entitlementUnit   LeaveDurationUnit @default(DAY) @map("entitlement_unit")
  policySnapshot    Json              @map("policy_snapshot")
  status            LeavePeriodStatus @default(OPEN)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  employee     Employee                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType                 @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  policy       LeavePolicy               @relation(fields: [policyId], references: [id], onDelete: Restrict)
  assignment   LeavePolicyAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  transactions LeaveTransaction[]
  requests     LeaveRequest[]
  reservations LeaveBalanceReservation[]

  @@unique([employeeId, leaveTypeId, periodStart, periodEnd])
  @@index([employeeId, leaveTypeId, status])
  @@index([periodStart, periodEnd])
  @@map("leave_entitlement_periods")
}

/// Append-only signed ledger. Positive amounts credit the balance, negative amounts
/// consume it. The unique source key is the database-level idempotency guarantee.
model LeaveTransaction {
  id                  String               @id @default(uuid()) @db.Uuid
  employeeId          String               @map("employee_id") @db.Uuid
  leaveTypeId         String               @map("leave_type_id") @db.Uuid
  entitlementPeriodId String               @map("entitlement_period_id") @db.Uuid
  type                LeaveTransactionType
  amount              Decimal              @db.Decimal(10, 2)
  transactionDate     DateTime             @map("transaction_date") @db.Date
  expiresAt           DateTime?            @map("expires_at") @db.Date
  sourceType          String               @map("source_type") @db.VarChar(40)
  sourceRef           String               @map("source_ref") @db.VarChar(160)
  description         String?
  reversalOfId        String?              @map("reversal_of_id") @db.Uuid
  createdById         String?              @map("created_by_id") @db.Uuid
  createdAt           DateTime             @default(now()) @map("created_at")

  employee      Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType     LeaveType                    @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  period        LeaveEntitlementPeriod       @relation(fields: [entitlementPeriodId], references: [id], onDelete: Restrict)
  createdBy     User?                        @relation("LeaveTransactionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reversalOf    LeaveTransaction?            @relation("LeaveTransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals     LeaveTransaction[]           @relation("LeaveTransactionReversal")
  allocations   LeaveTransactionAllocation[] @relation("AllocationTransaction")
  allocatedFrom LeaveTransactionAllocation[] @relation("AllocationSource")

  @@unique([sourceType, sourceRef, type])
  @@index([employeeId, leaveTypeId, transactionDate])
  @@index([entitlementPeriodId])
  @@index([expiresAt])
  @@map("leave_transactions")
}

/// FIFO allocation detail: a debit transaction consumes named positive tranches.
model LeaveTransactionAllocation {
  id                  String   @id @default(uuid()) @db.Uuid
  transactionId       String   @map("transaction_id") @db.Uuid
  sourceTransactionId String   @map("source_transaction_id") @db.Uuid
  amount              Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  transaction       LeaveTransaction @relation("AllocationTransaction", fields: [transactionId], references: [id], onDelete: Cascade)
  sourceTransaction LeaveTransaction @relation("AllocationSource", fields: [sourceTransactionId], references: [id], onDelete: Restrict)

  @@unique([transactionId, sourceTransactionId])
  @@index([sourceTransactionId])
  @@map("leave_transaction_allocations")
}

model LeaveBalanceReservation {
  id                  String                 @id @default(uuid()) @db.Uuid
  requestId           String                 @unique @map("request_id") @db.Uuid
  employeeId          String                 @map("employee_id") @db.Uuid
  leaveTypeId         String                 @map("leave_type_id") @db.Uuid
  entitlementPeriodId String                 @map("entitlement_period_id") @db.Uuid
  amount              Decimal                @db.Decimal(10, 2)
  status              LeaveReservationStatus @default(PENDING)
  createdAt           DateTime               @default(now()) @map("created_at")
  releasedAt          DateTime?              @map("released_at")

  request   LeaveRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employee  Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType LeaveType              @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  period    LeaveEntitlementPeriod @relation(fields: [entitlementPeriodId], references: [id], onDelete: Restrict)

  @@index([employeeId, leaveTypeId, status])
  @@index([entitlementPeriodId, status])
  @@map("leave_balance_reservations")
}

model LeaveRequest {
  id                  String              @id @default(uuid()) @db.Uuid
  employeeId          String              @map("employee_id") @db.Uuid
  leaveTypeId         String              @map("leave_type_id") @db.Uuid
  entitlementPeriodId String              @map("entitlement_period_id") @db.Uuid
  clientRequestId     String?             @map("client_request_id") @db.VarChar(100)
  startDate           DateTime            @map("start_date") @db.Date
  endDate             DateTime            @map("end_date") @db.Date
  duration            Decimal             @db.Decimal(10, 2)
  durationUnit        LeaveDurationUnit   @default(DAY) @map("duration_unit")
  requestMode         LeaveRequestMode    @default(FULL_DAY) @map("request_mode")
  halfDayPeriod       LeaveHalfDayPeriod? @map("half_day_period")
  reason              String
  status              LeaveRequestStatus  @default(DRAFT)
  approvalStage       LeaveApprovalStage? @map("approval_stage")
  submittedAt         DateTime?           @map("submitted_at")
  reviewedById        String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?           @map("reviewed_at")
  reviewComments      String?             @map("review_comments")
  withdrawnAt         DateTime?           @map("withdrawn_at")
  cancelledAt         DateTime?           @map("cancelled_at")
  cancelledById       String?             @map("cancelled_by_id") @db.Uuid
  cancellationReason  String?             @map("cancellation_reason")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  employee          Employee                 @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType         LeaveType                @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  entitlementPeriod LeaveEntitlementPeriod   @relation(fields: [entitlementPeriodId], references: [id], onDelete: Restrict)
  reviewer          User?                    @relation("LeaveRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cancelledBy       User?                    @relation("LeaveRequestCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  days              LeaveRequestDay[]
  approvals         LeaveRequestApproval[]
  attachments       LeaveAttachment[]
  reservation       LeaveBalanceReservation?

  @@unique([employeeId, clientRequestId])
  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([leaveTypeId, startDate, endDate])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

model LeaveRequestDay {
  id            String              @id @default(uuid()) @db.Uuid
  requestId     String              @map("request_id") @db.Uuid
  date          DateTime            @db.Date
  duration      Decimal             @db.Decimal(4, 2)
  halfDayPeriod LeaveHalfDayPeriod? @map("half_day_period")

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, date])
  @@index([date])
  @@map("leave_request_days")
}

model LeaveRequestApproval {
  id          String                @id @default(uuid()) @db.Uuid
  requestId   String                @map("request_id") @db.Uuid
  stage       LeaveApprovalStage
  decision    LeaveApprovalDecision
  actorUserId String?               @map("actor_user_id") @db.Uuid
  actorName   String                @map("actor_name")
  comment     String?
  isOverride  Boolean               @default(false) @map("is_override")
  createdAt   DateTime              @default(now()) @map("created_at")

  request LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?        @relation("LeaveApprovalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([actorUserId])
  @@map("leave_request_approvals")
}

model LeaveAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @unique @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  request    LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User?        @relation("LeaveAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("leave_attachments")
}

// ---------------------------------------------------------------------------
// Phase 6 — Overtime management
// ---------------------------------------------------------------------------

enum OvertimeCategory {
  WEEKDAY
  WEEKEND
  HOLIDAY
  REST_DAY
}

enum OvertimeApprovalMode {
  MANAGER
  HR
  MANAGER_AND_HR
}

enum OvertimeApprovalStage {
  MANAGER
  HR
}

enum OvertimeApprovalDecision {
  APPROVED
  REJECTED
}

enum OvertimeStatus {
  DRAFT
  PENDING_MANAGER_APPROVAL
  PENDING_HR_APPROVAL
  APPROVED
  REJECTED
  WITHDRAWN
  PENDING_VERIFICATION
  VERIFIED
  CANCELLED
}

enum OvertimeRoundingStrategy {
  NONE
  ROUND_DOWN
  ROUND_UP
  NEAREST
}

/// Versioned rules. Requests snapshot the policy used at submission so later
/// edits cannot rewrite history.
model OvertimePolicy {
  id                         String                   @id @default(uuid()) @db.Uuid
  name                       String
  code                       String                   @unique
  description                String?
  status                     MasterStatus             @default(ACTIVE)
  effectiveFrom              DateTime                 @map("effective_from") @db.Date
  effectiveTo                DateTime?                @map("effective_to") @db.Date
  minMinutes                 Int                      @default(30) @map("min_minutes")
  maxMinutes                 Int                      @default(240) @map("max_minutes")
  roundingStrategy           OvertimeRoundingStrategy @default(NONE) @map("rounding_strategy")
  roundingMinutes            Int                      @default(15) @map("rounding_minutes")
  approvalMode               OvertimeApprovalMode     @default(MANAGER) @map("approval_mode")
  requiresAttachment         Boolean                  @default(false) @map("requires_attachment")
  allowWeekend               Boolean                  @default(false) @map("allow_weekend")
  allowHoliday               Boolean                  @default(false) @map("allow_holiday")
  eligibleEmploymentStatuses EmploymentStatus[]       @default([]) @map("eligible_employment_statuses")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  assignments OvertimePolicyAssignment[]
  requests    OvertimeRequest[]

  @@index([status, effectiveFrom])
  @@map("overtime_policies")
}

/// Exactly one of employee/department/branch is set. Overlap checks live in the
/// service because Prisma cannot express a partial exclusion constraint.
/// DB checks enforce exactly one of employee/department/branch and a valid effective range.
model OvertimePolicyAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  policyId      String    @map("policy_id") @db.Uuid
  employeeId    String?   @map("employee_id") @db.Uuid
  departmentId  String?   @map("department_id") @db.Uuid
  branchId      String?   @map("branch_id") @db.Uuid
  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  notes         String?
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  policy     OvertimePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  employee   Employee?      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department Department?    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  branch     Branch?        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  createdBy  User?          @relation("OvertimeAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([policyId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([departmentId, effectiveFrom, effectiveTo])
  @@index([branchId, effectiveFrom, effectiveTo])
  @@map("overtime_policy_assignments")
}

model OvertimeRequest {
  id                  String                 @id @default(uuid()) @db.Uuid
  employeeId          String                 @map("employee_id") @db.Uuid
  policyId            String                 @map("policy_id") @db.Uuid
  attendanceRecordId  String?                @map("attendance_record_id") @db.Uuid
  clientRequestId     String?                @map("client_request_id") @db.VarChar(100)
  workDate            DateTime               @map("work_date") @db.Date
  category            OvertimeCategory
  reason              String
  plannedStartAt      DateTime               @map("planned_start_at")
  plannedEndAt        DateTime               @map("planned_end_at")
  plannedBreakMinutes Int                    @default(0) @map("planned_break_minutes")
  actualStartAt       DateTime?              @map("actual_start_at")
  actualEndAt         DateTime?              @map("actual_end_at")
  actualBreakMinutes  Int?                   @map("actual_break_minutes")
  requestedMinutes    Int                    @map("requested_minutes")
  actualMinutes       Int?                   @map("actual_minutes")
  verifiedMinutes     Int?                   @map("verified_minutes")
  approvedMinutes     Int?                   @map("approved_minutes")
  status              OvertimeStatus         @default(DRAFT)
  approvalStage       OvertimeApprovalStage? @map("approval_stage")
  policySnapshot      Json                   @map("policy_snapshot")
  submittedAt         DateTime?              @map("submitted_at")
  completedAt         DateTime?              @map("completed_at")
  verifiedAt          DateTime?              @map("verified_at")
  verifiedById        String?                @map("verified_by_id") @db.Uuid
  cancelledAt         DateTime?              @map("cancelled_at")
  cancelledById       String?                @map("cancelled_by_id") @db.Uuid
  cancellationReason  String?                @map("cancellation_reason")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  policy           OvertimePolicy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  attendanceRecord AttendanceRecord?    @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  verifier         User?                @relation("OvertimeRequestVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  cancelledBy      User?                @relation("OvertimeRequestCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  approvals        OvertimeApproval[]
  corrections      OvertimeCorrection[]
  attachments      OvertimeAttachment[]

  @@unique([employeeId, clientRequestId])
  @@index([employeeId, status])
  @@index([employeeId, plannedStartAt, plannedEndAt])
  @@index([status, createdAt])
  @@index([workDate, status])
  @@index([policyId])
  @@index([attendanceRecordId])
  @@map("overtime_requests")
}

/// Append-only decision history. Rows are never updated or deleted.
model OvertimeApproval {
  id             String                   @id @default(uuid()) @db.Uuid
  requestId      String                   @map("request_id") @db.Uuid
  stage          OvertimeApprovalStage
  decision       OvertimeApprovalDecision
  approverUserId String?                  @map("approver_user_id") @db.Uuid
  approverName   String                   @map("approver_name")
  comment        String?
  isOverride     Boolean                  @default(false) @map("is_override")
  createdAt      DateTime                 @default(now()) @map("created_at")

  request  OvertimeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User?           @relation("OvertimeApprovalActor", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([approverUserId])
  @@map("overtime_approvals")
}

/// Immutable trail for changes to verified minutes.
model OvertimeCorrection {
  id             String   @id @default(uuid()) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  previousValue  Int      @map("previous_value")
  correctedValue Int      @map("corrected_value")
  reason         String
  correctedById  String?  @map("corrected_by_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  request     OvertimeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  correctedBy User?           @relation("OvertimeCorrectionActor", fields: [correctedById], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("overtime_corrections")
}

model OvertimeAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  requestId    String   @map("request_id") @db.Uuid
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storageKey   String   @unique @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  request    OvertimeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  uploadedBy User?           @relation("OvertimeAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("overtime_attachments")
}

// ---------------------------------------------------------------------------
// Phase 7 — Payroll management
// ---------------------------------------------------------------------------

enum PayrollComponentType {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
  INFORMATIONAL
}

enum PayrollCalculationType {
  FIXED_AMOUNT
  PERCENTAGE
  MANUAL_AMOUNT
  SOURCE_BASED
}

enum PayrollSourceType {
  ABSENCE
  LATE
  EARLY_LEAVE
  UNPAID_LEAVE
  OVERTIME
}

enum PayrollSourceKind {
  ATTENDANCE
  LEAVE
  OVERTIME
  ADJUSTMENT
}

enum PayrollPaymentFrequency {
  MONTHLY
  SEMI_MONTHLY
  BIWEEKLY
  WEEKLY
}

enum PayrollPeriodStatus {
  OPEN
  CLOSED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATING
  CALCULATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  LOCKED
  CANCELLED
}

enum PayrollAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollRunAction {
  SUBMIT_REVIEW
  APPROVE
  PUBLISH
  CANCEL
  RECALCULATE
}

enum PayrollRoundingMode {
  HALF_UP
  ROUND_DOWN
  ROUND_UP
}

/// Single-row calculation settings for the company. The service creates it on demand.
model PayrollSetting {
  id                   String              @id @default(uuid()) @db.Uuid
  standardMonthlyHours Decimal             @default(173.00) @map("standard_monthly_hours") @db.Decimal(6, 2)
  standardMonthlyDays  Decimal             @default(22.00) @map("standard_monthly_days") @db.Decimal(6, 2)
  roundingMode         PayrollRoundingMode @default(HALF_UP) @map("rounding_mode")
  currencyScale        Int                 @default(2) @map("currency_scale")
  updatedById          String?             @map("updated_by_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  @@map("payroll_settings")
}

/// Effective-dated salary history. A database exclusion constraint prevents overlapping active rows.
model EmployeeCompensation {
  id               String                  @id @default(uuid()) @db.Uuid
  employeeId       String                  @map("employee_id") @db.Uuid
  baseSalary       Decimal                 @map("base_salary") @db.Decimal(18, 2)
  currency         String                  @default("IDR")
  paymentFrequency PayrollPaymentFrequency @default(MONTHLY) @map("payment_frequency")
  effectiveFrom    DateTime                @map("effective_from") @db.Date
  effectiveTo      DateTime?               @map("effective_to") @db.Date
  status           MasterStatus            @default(ACTIVE)
  notes            String?
  createdById      String?                 @map("created_by_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("PayrollCompensationCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([status, effectiveFrom])
  @@map("employee_compensations")
}

model PayrollComponent {
  id              String                 @id @default(uuid()) @db.Uuid
  code            String                 @unique
  name            String
  description     String?
  componentType   PayrollComponentType   @map("component_type")
  calculationType PayrollCalculationType @map("calculation_type")
  defaultAmount   Decimal                @default(0) @map("default_amount") @db.Decimal(18, 2)
  percentage      Decimal?               @db.Decimal(9, 4)
  rateMultiplier  Decimal?               @map("rate_multiplier") @db.Decimal(9, 4)
  sourceType      PayrollSourceType?     @map("source_type")
  isTaxable       Boolean                @default(false) @map("is_taxable")
  isRecurring     Boolean                @default(true) @map("is_recurring")
  isActive        Boolean                @default(true) @map("is_active")
  effectiveFrom   DateTime               @map("effective_from") @db.Date
  effectiveTo     DateTime?              @map("effective_to") @db.Date
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  assignments EmployeePayrollAssignment[]
  lines       PayrollLine[]
  adjustments PayrollAdjustment[]

  @@index([isActive, componentType])
  @@index([effectiveFrom, effectiveTo])
  @@map("payroll_components")
}

model EmployeePayrollAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  employeeId     String       @map("employee_id") @db.Uuid
  componentId    String       @map("component_id") @db.Uuid
  amountOverride Decimal?     @map("amount_override") @db.Decimal(18, 2)
  effectiveFrom  DateTime     @map("effective_from") @db.Date
  effectiveTo    DateTime?    @map("effective_to") @db.Date
  status         MasterStatus @default(ACTIVE)
  notes          String?
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  employee  Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  component PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("PayrollAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([componentId, effectiveFrom, effectiveTo])
  @@map("employee_payroll_assignments")
}

model PayrollPeriod {
  id          String              @id @default(uuid()) @db.Uuid
  name        String
  startDate   DateTime            @map("start_date") @db.Date
  endDate     DateTime            @map("end_date") @db.Date
  paymentDate DateTime            @map("payment_date") @db.Date
  status      PayrollPeriodStatus @default(OPEN)
  notes       String?
  createdById String?             @map("created_by_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  createdBy   User?               @relation("PayrollPeriodCreator", fields: [createdById], references: [id], onDelete: SetNull)
  runs        PayrollRun[]
  adjustments PayrollAdjustment[]

  @@index([startDate, endDate])
  @@index([status])
  @@map("payroll_periods")
}

model PayrollRun {
  id                        String              @id @default(uuid()) @db.Uuid
  periodId                  String              @map("period_id") @db.Uuid
  runNumber                 Int                 @map("run_number")
  status                    PayrollRunStatus    @default(DRAFT)
  calculationVersion        Int                 @default(0) @map("calculation_version")
  currency                  String              @default("IDR")
  standardMonthlyHours      Decimal             @map("standard_monthly_hours") @db.Decimal(6, 2)
  standardMonthlyDays       Decimal             @map("standard_monthly_days") @db.Decimal(6, 2)
  roundingMode              PayrollRoundingMode @map("rounding_mode")
  currencyScale             Int                 @map("currency_scale")
  grossTotal                Decimal             @default(0) @map("gross_total") @db.Decimal(18, 2)
  deductionTotal            Decimal             @default(0) @map("deduction_total") @db.Decimal(18, 2)
  netTotal                  Decimal             @default(0) @map("net_total") @db.Decimal(18, 2)
  employerContributionTotal Decimal             @default(0) @map("employer_contribution_total") @db.Decimal(18, 2)
  warnings                  Json?
  calculatedAt              DateTime?           @map("calculated_at")
  reviewedAt                DateTime?           @map("reviewed_at")
  approvedAt                DateTime?           @map("approved_at")
  publishedAt               DateTime?           @map("published_at")
  lockedAt                  DateTime?           @map("locked_at")
  cancelledAt               DateTime?           @map("cancelled_at")
  cancelReason              String?             @map("cancel_reason")
  createdById               String?             @map("created_by_id") @db.Uuid
  approvedById              String?             @map("approved_by_id") @db.Uuid
  publishedById             String?             @map("published_by_id") @db.Uuid
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")

  period      PayrollPeriod        @relation(fields: [periodId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("PayrollRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy  User?                @relation("PayrollRunApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  publishedBy User?                @relation("PayrollRunPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  payslips    PayrollPayslip[]
  approvals   PayrollRunApproval[]

  @@unique([periodId, runNumber])
  @@index([status, createdAt])
  @@map("payroll_runs")
}

model PayrollRunApproval {
  id          String           @id @default(uuid()) @db.Uuid
  runId       String           @map("run_id") @db.Uuid
  action      PayrollRunAction
  actorUserId String?          @map("actor_user_id") @db.Uuid
  actorName   String           @map("actor_name")
  comment     String?
  createdAt   DateTime         @default(now()) @map("created_at")

  run   PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  actor User?      @relation("PayrollRunApprovalActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([runId, createdAt])
  @@map("payroll_run_approvals")
}

model PayrollPayslip {
  id                     String    @id @default(uuid()) @db.Uuid
  runId                  String    @map("run_id") @db.Uuid
  employeeId             String    @map("employee_id") @db.Uuid
  employeeNumberSnapshot String    @map("employee_number_snapshot")
  employeeNameSnapshot   String    @map("employee_name_snapshot")
  departmentSnapshot     String?   @map("department_snapshot")
  positionSnapshot       String?   @map("position_snapshot")
  currency               String
  baseSalary             Decimal   @map("base_salary") @db.Decimal(18, 2)
  grossPay               Decimal   @map("gross_pay") @db.Decimal(18, 2)
  totalDeductions        Decimal   @map("total_deductions") @db.Decimal(18, 2)
  employerContributions  Decimal   @default(0) @map("employer_contributions") @db.Decimal(18, 2)
  netPay                 Decimal   @map("net_pay") @db.Decimal(18, 2)
  compensationSnapshot   Json      @map("compensation_snapshot")
  assignmentSnapshot     Json      @map("assignment_snapshot")
  attendanceSnapshot     Json      @map("attendance_snapshot")
  leaveSnapshot          Json      @map("leave_snapshot")
  overtimeSnapshot       Json      @map("overtime_snapshot")
  adjustmentSnapshot     Json      @map("adjustment_snapshot")
  settingsSnapshot       Json      @map("settings_snapshot")
  warnings               Json?
  publishedAt            DateTime? @map("published_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  run      PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lines    PayrollLine[]
  sources  PayrollSource[]

  @@unique([runId, employeeId])
  @@index([employeeId, publishedAt])
  @@map("payroll_payslips")
}

model PayrollLine {
  id              String                 @id @default(uuid()) @db.Uuid
  payslipId       String                 @map("payslip_id") @db.Uuid
  componentId     String?                @map("component_id") @db.Uuid
  code            String
  name            String
  componentType   PayrollComponentType   @map("component_type")
  calculationType PayrollCalculationType @map("calculation_type")
  quantity        Decimal?               @db.Decimal(18, 4)
  rate            Decimal?               @db.Decimal(18, 6)
  amount          Decimal                @db.Decimal(18, 2)
  sourceType      PayrollSourceType?     @map("source_type")
  notes           String?
  createdAt       DateTime               @default(now()) @map("created_at")

  payslip   PayrollPayslip    @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  component PayrollComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([payslipId])
  @@index([componentId])
  @@map("payroll_lines")
}

model PayrollSource {
  id        String            @id @default(uuid()) @db.Uuid
  payslipId String            @map("payslip_id") @db.Uuid
  kind      PayrollSourceKind
  sourceId  String            @map("source_id") @db.Uuid
  reference Json?
  quantity  Decimal?          @db.Decimal(18, 4)
  amount    Decimal?          @db.Decimal(18, 2)
  createdAt DateTime          @default(now()) @map("created_at")

  payslip PayrollPayslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@unique([payslipId, kind, sourceId])
  @@index([kind, sourceId])
  @@map("payroll_sources")
}

model PayrollAdjustment {
  id            String                  @id @default(uuid()) @db.Uuid
  periodId      String                  @map("period_id") @db.Uuid
  employeeId    String                  @map("employee_id") @db.Uuid
  componentId   String                  @map("component_id") @db.Uuid
  amount        Decimal                 @db.Decimal(18, 2)
  reason        String
  status        PayrollAdjustmentStatus @default(PENDING)
  createdById   String?                 @map("created_by_id") @db.Uuid
  reviewedById  String?                 @map("reviewed_by_id") @db.Uuid
  reviewedAt    DateTime?               @map("reviewed_at")
  reviewComment String?                 @map("review_comment")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  period     PayrollPeriod    @relation(fields: [periodId], references: [id], onDelete: Restrict)
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  component  PayrollComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  createdBy  User?            @relation("PayrollAdjustmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy User?            @relation("PayrollAdjustmentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([periodId, status])
  @@index([employeeId, periodId])
  @@map("payroll_adjustments")
}

// ---------------------------------------------------------------------------
// Phase 8 — Onboarding and offboarding
// ---------------------------------------------------------------------------

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum OnboardingTaskCategory {
  DOCUMENTATION
  HR_ADMINISTRATION
  IT_SETUP
  EQUIPMENT
  ORIENTATION
  DEPARTMENT_INTRODUCTION
  OTHER
}

enum OffboardingStatus {
  INITIATED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OffboardingReasonCategory {
  RESIGNATION
  CONTRACT_END
  TERMINATION
  RETIREMENT
  OTHER
}

enum OffboardingTaskCategory {
  HR_ADMINISTRATION
  DOCUMENTATION
  KNOWLEDGE_TRANSFER
  EQUIPMENT_RETURN
  ACCESS_REVIEW
  PAYROLL_REVIEW
  EXIT_INTERVIEW
  OTHER
}

model OnboardingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks   OnboardingTaskTemplate[]
  records EmployeeOnboarding[]

  @@index([isActive])
  @@map("onboarding_templates")
}

model OnboardingTaskTemplate {
  id            String                 @id @default(uuid()) @db.Uuid
  templateId    String                 @map("template_id") @db.Uuid
  title         String
  description   String?
  category      OnboardingTaskCategory @default(OTHER)
  assignedRole  String?                @map("assigned_role")
  dueOffsetDays Int                    @default(0) @map("due_offset_days")
  isRequired    Boolean                @default(true) @map("is_required")
  sortOrder     Int                    @default(0) @map("sort_order")
  createdAt     DateTime               @default(now()) @map("created_at")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@map("onboarding_task_templates")
}

model EmployeeOnboarding {
  id                     String           @id @default(uuid()) @db.Uuid
  employeeId             String           @map("employee_id") @db.Uuid
  templateId             String           @map("template_id") @db.Uuid
  startDate              DateTime         @map("start_date") @db.Date
  expectedCompletionDate DateTime?        @map("expected_completion_date") @db.Date
  completedAt            DateTime?        @map("completed_at")
  status                 OnboardingStatus @default(NOT_STARTED)
  notes                  String?
  createdById            String?          @map("created_by_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")

  employee  Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  template  OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  createdBy User?              @relation("OnboardingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     OnboardingTask[]

  @@unique([employeeId, startDate])
  @@index([employeeId, status])
  @@index([status, expectedCompletionDate])
  @@map("employee_onboardings")
}

model OnboardingTask {
  id           String                 @id @default(uuid()) @db.Uuid
  onboardingId String                 @map("onboarding_id") @db.Uuid
  title        String
  description  String?
  category     OnboardingTaskCategory @default(OTHER)
  assignedToId String?                @map("assigned_to_id") @db.Uuid
  dueDate      DateTime?              @map("due_date") @db.Date
  completedAt  DateTime?              @map("completed_at")
  status       TaskStatus             @default(PENDING)
  notes        String?
  isRequired   Boolean                @default(true) @map("is_required")
  sortOrder    Int                    @default(0) @map("sort_order")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")

  onboarding EmployeeOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  assignedTo User?              @relation("OnboardingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([onboardingId, status])
  @@index([assignedToId, dueDate])
  @@map("onboarding_tasks")
}

model OffboardingTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks   OffboardingTaskTemplate[]
  records EmployeeOffboarding[]

  @@index([isActive])
  @@map("offboarding_templates")
}

model OffboardingTaskTemplate {
  id            String                  @id @default(uuid()) @db.Uuid
  templateId    String                  @map("template_id") @db.Uuid
  title         String
  description   String?
  category      OffboardingTaskCategory @default(OTHER)
  assignedRole  String?                 @map("assigned_role")
  dueOffsetDays Int                     @default(0) @map("due_offset_days")
  isRequired    Boolean                 @default(true) @map("is_required")
  sortOrder     Int                     @default(0) @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at")

  template OffboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
  @@index([templateId])
  @@map("offboarding_task_templates")
}

model EmployeeOffboarding {
  id                   String                    @id @default(uuid()) @db.Uuid
  employeeId           String                    @map("employee_id") @db.Uuid
  templateId           String?                   @map("template_id") @db.Uuid
  resignationDate      DateTime                  @map("resignation_date") @db.Date
  lastWorkingDate      DateTime                  @map("last_working_date") @db.Date
  reasonCategory       OffboardingReasonCategory @default(RESIGNATION) @map("reason_category")
  reason               String?
  status               OffboardingStatus         @default(INITIATED)
  initiatedById        String?                   @map("initiated_by_id") @db.Uuid
  completedAt          DateTime?                 @map("completed_at")
  exitInterviewNotes   String?                   @map("exit_interview_notes")
  equipmentReturnNotes String?                   @map("equipment_return_notes")
  accessReviewNotes    String?                   @map("access_review_notes")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  employee    Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  template    OffboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  initiatedBy User?                @relation("OffboardingInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  tasks       OffboardingTask[]

  @@index([employeeId, status])
  @@index([status, lastWorkingDate])
  @@map("employee_offboardings")
}

model OffboardingTask {
  id            String                  @id @default(uuid()) @db.Uuid
  offboardingId String                  @map("offboarding_id") @db.Uuid
  title         String
  description   String?
  category      OffboardingTaskCategory @default(OTHER)
  assignedToId  String?                 @map("assigned_to_id") @db.Uuid
  dueDate       DateTime?               @map("due_date") @db.Date
  completedAt   DateTime?               @map("completed_at")
  status        TaskStatus              @default(PENDING)
  notes         String?
  isRequired    Boolean                 @default(true) @map("is_required")
  sortOrder     Int                     @default(0) @map("sort_order")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  offboarding EmployeeOffboarding @relation(fields: [offboardingId], references: [id], onDelete: Cascade)
  assignedTo  User?               @relation("OffboardingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([offboardingId, status])
  @@index([assignedToId, dueDate])
  @@map("offboarding_tasks")
}

// ---------------------------------------------------------------------------
// Phase 8 — Performance management
// ---------------------------------------------------------------------------

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  REVIEW_IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PerformanceGoalCategory {
  BUSINESS
  LEADERSHIP
  DEVELOPMENT
  BEHAVIORAL
  OTHER
}

enum PerformanceMeasurementType {
  NUMERIC
  PERCENTAGE
  BOOLEAN
  QUALITATIVE
}

enum PerformanceGoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  MISSED
  CANCELLED
}

enum PerformanceReviewType {
  SELF_REVIEW
  MANAGER_REVIEW
  HR_REVIEW
}

enum PerformanceReviewStatus {
  DRAFT
  SUBMITTED
  COMPLETED
}

model PerformanceCycle {
  id              String                 @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  startDate       DateTime               @map("start_date") @db.Date
  endDate         DateTime               @map("end_date") @db.Date
  reviewStartDate DateTime               @map("review_start_date") @db.Date
  reviewEndDate   DateTime               @map("review_end_date") @db.Date
  status          PerformanceCycleStatus @default(DRAFT)
  createdById     String?                @map("created_by_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  createdBy User?               @relation("PerformanceCycleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  goals     PerformanceGoal[]
  reviews   PerformanceReview[]

  @@index([status, startDate])
  @@index([startDate, endDate])
  @@map("performance_cycles")
}

model PerformanceGoal {
  id              String                     @id @default(uuid()) @db.Uuid
  employeeId      String                     @map("employee_id") @db.Uuid
  cycleId         String                     @map("cycle_id") @db.Uuid
  title           String
  description     String?
  category        PerformanceGoalCategory    @default(OTHER)
  measurementType PerformanceMeasurementType @default(QUALITATIVE) @map("measurement_type")
  targetValue     Decimal?                   @map("target_value") @db.Decimal(18, 2)
  currentValue    Decimal?                   @map("current_value") @db.Decimal(18, 2)
  weight          Decimal                    @db.Decimal(5, 2)
  status          PerformanceGoalStatus      @default(DRAFT)
  createdById     String?                    @map("created_by_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  employee  Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  cycle     PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  createdBy User?                   @relation("PerformanceGoalCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updates   PerformanceGoalUpdate[]
  items     PerformanceReviewItem[]

  @@index([employeeId, cycleId])
  @@index([cycleId, status])
  @@map("performance_goals")
}

model PerformanceGoalUpdate {
  id            String   @id @default(uuid()) @db.Uuid
  goalId        String   @map("goal_id") @db.Uuid
  previousValue Decimal? @map("previous_value") @db.Decimal(18, 2)
  newValue      Decimal? @map("new_value") @db.Decimal(18, 2)
  comment       String?
  updatedById   String?  @map("updated_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  goal      PerformanceGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  updatedBy User?           @relation("PerformanceGoalUpdateActor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([goalId, createdAt])
  @@map("performance_goal_updates")
}

model PerformanceReview {
  id            String                  @id @default(uuid()) @db.Uuid
  cycleId       String                  @map("cycle_id") @db.Uuid
  employeeId    String                  @map("employee_id") @db.Uuid
  reviewerId    String?                 @map("reviewer_id") @db.Uuid
  reviewType    PerformanceReviewType   @map("review_type")
  status        PerformanceReviewStatus @default(DRAFT)
  overallRating Decimal?                @map("overall_rating") @db.Decimal(3, 1)
  summary       String?
  internalNotes String?                 @map("internal_notes")
  submittedAt   DateTime?               @map("submitted_at")
  completedAt   DateTime?               @map("completed_at")
  createdById   String?                 @map("created_by_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  cycle     PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  employee  Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer  User?                   @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdBy User?                   @relation("PerformanceReviewCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     PerformanceReviewItem[]

  @@unique([cycleId, employeeId, reviewType])
  @@index([cycleId, status])
  @@index([employeeId, createdAt])
  @@map("performance_reviews")
}

model PerformanceReviewItem {
  id       String   @id @default(uuid()) @db.Uuid
  reviewId String   @map("review_id") @db.Uuid
  goalId   String?  @map("goal_id") @db.Uuid
  rating   Decimal? @db.Decimal(3, 1)
  comments String?
  evidence String?

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  goal   PerformanceGoal?  @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([reviewId])
  @@index([goalId])
  @@map("performance_review_items")
}

// ---------------------------------------------------------------------------
// Phase 8 — Learning and development
// ---------------------------------------------------------------------------

enum TrainingType {
  INTERNAL
  EXTERNAL
  ONLINE
  WORKSHOP
  SEMINAR
  CERTIFICATION
  OTHER
}

enum TrainingDeliveryMethod {
  IN_PERSON
  ONLINE
  HYBRID
}

enum TrainingProgramStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum TrainingEnrollmentStatus {
  REQUESTED
  APPROVED
  REJECTED
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FAILED
}

enum TrainingDocumentKind {
  MATERIAL
  CERTIFICATE
  OTHER
}

model TrainingProgram {
  id                   String                 @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  category             String?
  trainingType         TrainingType           @default(INTERNAL) @map("training_type")
  provider             String?
  durationMinutes      Int?                   @map("duration_minutes")
  deliveryMethod       TrainingDeliveryMethod @default(IN_PERSON) @map("delivery_method")
  location             String?
  registrationDeadline DateTime?              @map("registration_deadline") @db.Date
  startDate            DateTime               @map("start_date") @db.Date
  endDate              DateTime               @map("end_date") @db.Date
  capacity             Int?
  status               TrainingProgramStatus  @default(DRAFT)
  createdById          String?                @map("created_by_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  createdBy   User?                @relation("TrainingProgramCreator", fields: [createdById], references: [id], onDelete: SetNull)
  enrollments TrainingEnrollment[]
  documents   TrainingDocument[]

  @@index([status, startDate])
  @@index([registrationDeadline])
  @@map("training_programs")
}

model TrainingEnrollment {
  id           String                   @id @default(uuid()) @db.Uuid
  programId    String                   @map("program_id") @db.Uuid
  employeeId   String                   @map("employee_id") @db.Uuid
  status       TrainingEnrollmentStatus @default(REQUESTED)
  enrolledAt   DateTime?                @map("enrolled_at")
  approvedById String?                  @map("approved_by_id") @db.Uuid
  completedAt  DateTime?                @map("completed_at")
  result       String?
  feedback     String?
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  program    TrainingProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  approvedBy User?              @relation("TrainingEnrollmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  documents  TrainingDocument[]

  @@unique([programId, employeeId])
  @@index([employeeId, status])
  @@index([programId, status])
  @@map("training_enrollments")
}

model TrainingDocument {
  id           String               @id @default(uuid()) @db.Uuid
  programId    String               @map("program_id") @db.Uuid
  enrollmentId String?              @map("enrollment_id") @db.Uuid
  employeeId   String?              @map("employee_id") @db.Uuid
  kind         TrainingDocumentKind @default(MATERIAL)
  title        String
  fileName     String               @map("file_name")
  mimeType     String               @map("mime_type")
  sizeBytes    Int                  @map("size_bytes")
  storageKey   String               @unique @map("storage_key")
  issuedAt     DateTime?            @map("issued_at") @db.Date
  expiresAt    DateTime?            @map("expires_at") @db.Date
  uploadedById String?              @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")

  program    TrainingProgram     @relation(fields: [programId], references: [id], onDelete: Cascade)
  enrollment TrainingEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  employee   Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedBy User?               @relation("TrainingDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([programId, kind])
  @@index([employeeId, kind])
  @@index([enrollmentId])
  @@map("training_documents")
}
